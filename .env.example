# ==========================================
# LLM Configuration
# ==========================================

LLM_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key

# ==========================================
# Tavily
# ==========================================

TAVILY_API_KEY=your_tavily_api_key

# ==========================================
# Optional Settings
# ==========================================

LOG_LEVEL=INFO
MAX_PARALLEL_EXTRACTIONS=5
MAX_SEARCH_RESULTS=10
QDRANT_PATH=./qdrant_db
QDRANT_COLLECTION=research_memory_hybrid
QDRANT_SPARSE_MODEL=Qdrant/bm25
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5501
# Set API_KEY to require Bearer authentication for research and PDF endpoints.
# API_KEY=
